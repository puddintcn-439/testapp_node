{
  "name": "testapp",
  "version": "1.0.0",
  "description": "A basic Node.js app with TypeScript",
  "engines": {
    "node": "24.x"
  },
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "check:prod-structure": "node tools/checkProdStructure.js",
    "dev": "ts-node src/index.ts",
    "dev:client": "npm run dev --prefix client",
    "dev:all": "concurrently \"npm run dev\" \"npm run dev:client\"",
    "test": "jest",
    "gen:map": "node scripts/generate_project_map.js",
    "migrate": "ts-node scripts/migrate.ts up",
    "migrate:down": "ts-node scripts/migrate.ts down",
    "migrate:status": "ts-node scripts/migrate.ts status",
    "lint": "eslint 'src/**/*.ts' --ext .ts,.tsx",
    "format": "prettier --write .",
    "prepare": "husky install",
    "e2e": "npx playwright test"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@types/axios": "^0.9.36",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jest": "^29.5.2",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/mssql": "^9.1.11",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.20.0",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "@vercel/node": "^5.7.1",
    "axios": "^1.15.1",
    "concurrently": "^9.2.1",
    "jest": "^29.6.1",
    "ts-jest": "^29.1.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.0",
    "supertest": "^6.3.3",
    "@types/supertest": "^2.0.12",
    "eslint-config-prettier": "^9.0.0"
  ,
    "eslint": "^8.50.0",
    "@typescript-eslint/parser": "^6.0.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "prettier": "^2.8.8",
    "husky": "^8.0.0",
    "lint-staged": "^13.0.0",
    "@playwright/test": "^1.35.0"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.6",
    "dotenv": "^17.4.0",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.0",
    "mssql": "^12.2.1",
    "pg": "^8.20.0",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1"
  }
  ,
  "engines": {
    "node": ">=18"
  }

  ,
  "lint-staged": {
    "src/**/*.{ts,tsx,js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ]
  }
}
